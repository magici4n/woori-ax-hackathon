# API 키는 백엔드 프로세스 환경변수로만 설정합니다. 실제 키를 이 파일에 쓰지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
AI_MAX_CALLS=40
AI_BUDGET_USD=20
# 모델 변경 시 공식 가격표를 확인하고 함께 바꿉니다(USD / 1M tokens).
AI_INPUT_USD_PER_MILLION=2.00
AI_OUTPUT_USD_PER_MILLION=10.00
AI_WEB_SEARCH_USD_PER_CALL=0.01
AI_MAX_OUTPUT_TOKENS=5000
PORT=8080
